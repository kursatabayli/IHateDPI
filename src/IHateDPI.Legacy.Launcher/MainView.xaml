<UserControl x:Class="IHateDPI.Legacy.Launcher.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="350"
             Background="Transparent">

    <UserControl.Resources>
        <SolidColorBrush x:Key="TextWhite" Color="#F8F8F2"/>
        <SolidColorBrush x:Key="TextGray" Color="#6272A4"/>
        <Color x:Key="ColorRedPrimary">#FF5555</Color>
        <Color x:Key="ColorRedSecondary">#FFB86C</Color>
        <Color x:Key="ColorGreenPrimary">#50FA7B</Color>
        <Color x:Key="ColorGreenSecondary">#8BE9FD</Color>

        <Style x:Key="IconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.1" ScaleY="1.1" CenterX="12" CenterY="12"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Foreground" Value="#F8F8F2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid x:Name="DashboardPanel" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="80"/>
            </Grid.RowDefinitions>

            <TextBlock Text="IHateDPI" Foreground="{StaticResource TextWhite}" 
                       FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,0">
                <TextBlock.Effect>
                    <DropShadowEffect Color="#BD93F9" BlurRadius="15" Opacity="0.4"/>
                </TextBlock.Effect>
            </TextBlock>

            <ToggleButton x:Name="BtnPower" Grid.Row="1" 
                          HorizontalAlignment="Center" VerticalAlignment="Center"
                          Click="BtnPower_Click" Cursor="Hand">
                <ToggleButton.Template>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Ellipse Width="120" Height="120" Fill="#10FFFFFF">
                                <Ellipse.Effect>
                                    <BlurEffect Radius="20"/>
                                </Ellipse.Effect>
                            </Ellipse>

                            <Ellipse x:Name="InnerCircle" Width="100" Height="100" StrokeThickness="4">
                                <Ellipse.Stroke>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop x:Name="Stop0" Color="{StaticResource ColorRedPrimary}" Offset="0"/>
                                        <GradientStop x:Name="Stop1" Color="{StaticResource ColorRedSecondary}" Offset="1"/>
                                    </LinearGradientBrush>
                                </Ellipse.Stroke>
                                <Ellipse.Fill>
                                    <SolidColorBrush Color="#1E1E2E" Opacity="0.9"/>
                                </Ellipse.Fill>
                                <Ellipse.Effect>
                                    <DropShadowEffect x:Name="GlowEffect" Color="{StaticResource ColorGreenPrimary}" BlurRadius="0" ShadowDepth="0" Opacity="0"/>
                                </Ellipse.Effect>
                            </Ellipse>

                            <Path x:Name="PowerIcon" 
                                  Data="M12,2A1,1 0 0,0 11,3V13A1,1 0 0,0 13,13V3A1,1 0 0,0 12,2M18.84,5.84C18.45,5.45 17.82,5.45 17.43,5.84C17.04,6.23 17.04,6.86 17.43,7.25C19.86,9.68 19.86,13.61 17.43,16.04A6.22,6.22 0 0,1 8.57,16.04C6.14,13.61 6.14,9.68 8.57,7.25C8.96,6.86 8.96,6.23 8.57,5.84C8.18,5.45 7.55,5.45 7.16,5.84C4,9 4,14.15 7.16,17.31A8.25,8.25 0 0,0 18.84,17.31C22,14.15 22,9 18.84,5.84Z" 
                                  Stretch="Uniform" Width="36" Height="36" RenderTransformOrigin="0.5,0.5">
                                <Path.Fill>
                                    <SolidColorBrush x:Name="IconFill" Color="{StaticResource ColorRedPrimary}"/>
                                </Path.Fill>
                            </Path>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="ToggleButton.Checked">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="Stop0" Storyboard.TargetProperty="Color" To="{StaticResource ColorGreenPrimary}" Duration="0:0:0.5"/>
                                        <ColorAnimation Storyboard.TargetName="Stop1" Storyboard.TargetProperty="Color" To="{StaticResource ColorGreenSecondary}" Duration="0:0:0.5"/>
                                        <ColorAnimation Storyboard.TargetName="IconFill" Storyboard.TargetProperty="Color" To="{StaticResource ColorGreenPrimary}" Duration="0:0:0.5"/>
                                        <DoubleAnimation Storyboard.TargetName="GlowEffect" Storyboard.TargetProperty="BlurRadius" To="35" Duration="0:0:0.6">
                                            <DoubleAnimation.EasingFunction>
                                                <CircleEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="GlowEffect" Storyboard.TargetProperty="Opacity" To="0.8" Duration="0:0:0.5"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="ToggleButton.Unchecked">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation Storyboard.TargetName="Stop0" Storyboard.TargetProperty="Color" To="{StaticResource ColorRedPrimary}" Duration="0:0:0.5"/>
                                        <ColorAnimation Storyboard.TargetName="Stop1" Storyboard.TargetProperty="Color" To="{StaticResource ColorRedSecondary}" Duration="0:0:0.5"/>
                                        <ColorAnimation Storyboard.TargetName="IconFill" Storyboard.TargetProperty="Color" To="{StaticResource ColorRedPrimary}" Duration="0:0:0.5"/>
                                        <DoubleAnimation Storyboard.TargetName="GlowEffect" Storyboard.TargetProperty="BlurRadius" To="0" Duration="0:0:0.5"/>
                                        <DoubleAnimation Storyboard.TargetName="GlowEffect" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.5"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </ToggleButton.Template>
            </ToggleButton>

            <Grid Grid.Row="2">

                <Button x:Name="BtnSettings" Click="BtnSettings_Click"
                        Style="{StaticResource IconButtonStyle}"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel>
                        <Path Data="M19.43,12.98C19.47,12.66 19.5,12.34 19.5,12C19.5,11.66 19.47,11.34 19.43,11.02L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11.02C4.53,11.34 4.5,11.66 4.5,12C4.5,12.34 4.53,12.66 4.57,12.98L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.04 4.95,18.95L7.44,17.95C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.68 16.04,18.34 16.56,17.95L19.05,18.95C19.27,19.04 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.98M12,15.5A3.5,3.5 0 1,1 15.5,12A3.5,3.5 0 0,1 12,15.5Z" 
                              Fill="{StaticResource TextGray}" Width="24" Height="24" Stretch="Uniform"/>
                        <TextBlock Text="Ayarlar" Foreground="{StaticResource TextGray}" FontSize="10" 
                                   HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>
                </Button>

                <StackPanel x:Name="PnlStatus" Opacity="0" IsHitTestVisible="False"
                            HorizontalAlignment="Center" VerticalAlignment="Center">

                    <TextBlock Text="BYPASS AKTİF" Foreground="#50FA7B" FontSize="14" FontWeight="Bold" 
                               HorizontalAlignment="Center">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="{StaticResource ColorGreenPrimary}" BlurRadius="15" ShadowDepth="0" Opacity="0.7"/>
                        </TextBlock.Effect>
                    </TextBlock>

                    <TextBlock x:Name="TxtActiveEngine" Text="Motor: IHateDPI" 
                               Foreground="{StaticResource TextGray}" FontSize="11" 
                               HorizontalAlignment="Center" Margin="0,5,0,0"/>

                    <TextBlock Text="DPI Engelleri Aşılıyor" Foreground="#45475A" FontSize="9" 
                               HorizontalAlignment="Center" Margin="0,2,0,0"/>
                </StackPanel>

            </Grid>
        </Grid>

        <ContentControl x:Name="SettingsContainer" Visibility="Collapsed"/>
    </Grid>
</UserControl>